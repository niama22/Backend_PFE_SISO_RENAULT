# Root env used by docker-compose.yml

# ───── Ports microservices ─────
CLIENT_PORT=3001
KONG_PORT=8000
KONG_ADMIN_PORT=8001

# ───── PostgreSQL ─────
POSTGRES_DB=siso_db
POSTGRES_USER=siso_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ───── TimescaleDB ─────
TIMESCALE_DB=siso_gps
TIMESCALE_USER=siso_user
TIMESCALE_PASSWORD=change_me
TIMESCALE_PORT=5433

# ───── Redis ─────
REDIS_HOST=redis
REDIS_PORT=6379

# ───── ElasticSearch ─────
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200

# ───── MinIO ─────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me

# ───── JWT ─────
JWT_SECRET=change_me
JWT_EXPIRATION=86400
